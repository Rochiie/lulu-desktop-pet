{
  "name": "lulu-desktop-pet",
  "productName": "Lulu",
  "version": "1.8.0",
  "description": "Lulu the miniature dachshund, living on your Windows desktop.",
  "author": "Cody",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "tune": "electron . --tune",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\"",
    "dist": "electron-builder --win nsis --publish never",
    "release": "node scripts/release.js",
    "make-clip": "electron tools/make-clip/main.js"
  },
  "build": {
    "appId": "com.cody.lulu",
    "productName": "Lulu",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/lulu_icon.ico"
    },
    "nsis": {
      "artifactName": "Lulu Setup.${ext}",
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "assets/lulu_icon.ico",
      "uninstallerIcon": "assets/lulu_icon.ico",
      "shortcutName": "Lulu"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Rochiie",
        "repo": "lulu-desktop-pet",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "koffi": "3.3.6"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "koffi@3.3.6": true,
    "electron-winstaller": false
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rochiie/lulu-desktop-pet.git"
  }
}
